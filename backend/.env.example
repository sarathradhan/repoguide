# Backend Environment Configuration
APP_NAME=RepoGuide AI
APP_DESCRIPTION="AI-powered GitHub repository understanding assistant"
APP_VERSION=0.2.0
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# GitHub Ingestion Limits
MAX_SOURCE_FILES=500
MAX_FILE_SIZE_BYTES=102400
MAX_TOTAL_SIZE_BYTES=5242880
CONCURRENT_DOWNLOADS_LIMIT=10

# Optional GitHub Personal Access Token (increases rate limit)
GITHUB_TOKEN=

# Milestone 3: local semantic index and embeddings
CHROMA_PERSIST_DIRECTORY=storage
CONVERSATIONS_DB_PATH=storage/conversations.sqlite3
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Milestone 4: Groq grounded repository answers (set locally; never sent to frontend)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=60
RAG_MIN_SIMILARITY=0.20
RAG_MAX_CONTEXT_CHARS=24000
